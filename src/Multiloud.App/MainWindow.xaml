<Window x:Class="Multiloud.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Multiloud.App.Controls" xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework" Style="{StaticResource {x:Type Window}}" Icon="Assets/AppIcon.ico" Title="Loudline — music loudness matching" Width="1440" Height="940" MinWidth="1100" MinHeight="740" AllowDrop="True" Drop="FilesDropped" DragOver="FilesDragOver" PreviewKeyDown="WindowKeyDown">
 <Window.Resources>
  <SolidColorBrush x:Key="LoopABrush" Color="#65B7EF"/>
  <SolidColorBrush x:Key="LoopBBrush" Color="#E5B759"/>
  <Style x:Key="LoopButtonStyle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
   <Setter Property="Height" Value="28"/><Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="11,4"/>
   <Setter Property="Background" Value="{DynamicResource ButtonBrush}"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <Border x:Name="LoopSurface" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="Tag" Value="First"><Setter TargetName="LoopSurface" Property="CornerRadius" Value="4,0,0,4"/></Trigger>
     <Trigger Property="Tag" Value="Last"><Setter TargetName="LoopSurface" Property="CornerRadius" Value="0,4,4,0"/></Trigger>
     <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsChecked" Value="False"/></MultiTrigger.Conditions><Setter TargetName="LoopSurface" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/></MultiTrigger>
     <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="#F5FAFF"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="LoopSurface" Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="LoopAButtonStyle" TargetType="CheckBox" BasedOn="{StaticResource LoopButtonStyle}">
   <Setter Property="Tag" Value="First"/>
   <Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="#286E9B"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="LoopBButtonStyle" TargetType="CheckBox" BasedOn="{StaticResource LoopButtonStyle}">
   <Setter Property="Tag" Value="Last"/>
   <Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="#8C692D"/></Trigger></Style.Triggers>
  </Style>
 </Window.Resources>
 <DockPanel>
  <Menu DockPanel.Dock="Top" Padding="6,2">
   <MenuItem Header="_File"><MenuItem Header="_Add audio files…" InputGestureText="Ctrl+O" Click="AddFilesClick"/><Separator/><MenuItem Header="_Open project…" InputGestureText="Ctrl+Shift+O" Click="OpenProjectClick"/><MenuItem x:Name="CloseProjectMenuItem" Header="_Close project" InputGestureText="Ctrl+W" Click="CloseProjectClick"/><Separator/><MenuItem Header="_Save project" InputGestureText="Ctrl+S" Click="SaveProjectClick"/><MenuItem Header="Save project _as…" Click="SaveProjectAsClick"/><Separator/><MenuItem Header="WAV format"><MenuItem x:Name="Wav24Item" Header="24-bit PCM" IsCheckable="True" IsChecked="True" Click="Wav24Click"/><MenuItem x:Name="WavFloatItem" Header="32-bit float" IsCheckable="True" Click="WavFloatClick"/></MenuItem><MenuItem Header="_Export all…" InputGestureText="Ctrl+E" Click="ExportClick"/><Separator/><MenuItem Header="E_xit" Click="ExitClick"/></MenuItem>
   <MenuItem Header="_Edit"><MenuItem Header="_Undo" InputGestureText="Ctrl+Z" Click="UndoClick"/><MenuItem Header="_Redo" InputGestureText="Ctrl+Y" Click="RedoClick"/><Separator/><MenuItem Header="Reset selected track" Click="ResetSelectedClick"/><MenuItem Header="Remove selected track" InputGestureText="Delete" Click="RemoveClick"/></MenuItem>
   <MenuItem Header="_View"><MenuItem x:Name="FileListVisibilityItem" Header="File list" InputGestureText="F" IsCheckable="True" IsChecked="True" Click="FileListVisibilityClick"/><Separator/><MenuItem Header="Fit whole release" InputGestureText="Home" Click="FitAllClick"/><MenuItem Header="Fit selected track" Click="FitSelectedClick"/><MenuItem Header="Rebuild preview" Click="RebuildClick"/><Separator/><MenuItem Header="Button style"><MenuItem x:Name="DefaultButtonStyleItem" Header="Default" IsCheckable="True" IsChecked="True" Click="DefaultButtonStyleClick"/><MenuItem x:Name="IconsOnlyButtonStyleItem" Header="Icons only" IsCheckable="True" Click="IconsOnlyButtonStyleClick"/></MenuItem><MenuItem Header="Theme"><MenuItem x:Name="SystemThemeItem" Header="Follow Windows" IsCheckable="True" Click="SystemThemeClick"/><MenuItem x:Name="DarkThemeItem" Header="Dark" IsCheckable="True" Click="DarkThemeClick"/><MenuItem x:Name="LightThemeItem" Header="Light" IsCheckable="True" Click="LightThemeClick"/></MenuItem></MenuItem>
   <MenuItem Header="_Help"><MenuItem x:Name="KeyboardShortcutsMenuItem" Header="Keyboard shortcuts" Click="KeyboardShortcutsClick"/><Separator/><MenuItem Header="About Loudline" Click="AboutClick"/></MenuItem>
  </Menu>
  <Border x:Name="CompactProcessingBar" DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Background="{DynamicResource PanelBrush}">
   <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalContentAlignment="Center" Padding="8,4">
    <ContentControl x:Name="CompactProcessingHost" HorizontalContentAlignment="Center">
    <Grid x:Name="ProcessingPanel" Height="44" HorizontalAlignment="Center">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Border Grid.Column="0" Style="{StaticResource ProcessingSectionSurface}" Tag="{Binding IsChecked, ElementName=LevelingCheck}">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
       <CheckBox x:Name="LevelingCheck" Style="{StaticResource SectionCheckToggle}" IsChecked="True" Checked="ProcessingChanged" Unchecked="ProcessingChanged" AutomationProperties.Name="Enable dynamic leveling"/>
       <StackPanel Style="{StaticResource ProcessingSectionBody}" Tag="{Binding IsChecked, ElementName=LevelingCheck}">
        <TextBlock Text="01  DYNAMIC LEVELING" Width="92" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
        <Grid VerticalAlignment="Center" Margin="8,0,0,0">
         <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="14"/><RowDefinition Height="22"/></Grid.RowDefinitions>
         <TextBlock x:Name="StrengthLabel" Text="Strength" FontSize="10" TextAlignment="Center" VerticalAlignment="Center"/>
         <Slider x:Name="StrengthSlider" Grid.Row="1" Minimum="0" Maximum="1" Value="0.65" Width="110" Height="22" SmallChange="0.01" LargeChange="0.1" IsMoveToPointEnabled="False" VerticalAlignment="Center" ValueChanged="StrengthChanged" PreviewMouseLeftButtonDown="StrengthEditStarted" PreviewKeyDown="StrengthKeyDown"/>
         <TextBlock x:Name="StrengthValueText" Grid.Row="1" Grid.Column="1" Text="65%" Width="46" TextAlignment="Right" FontSize="12" VerticalAlignment="Center" Margin="4,0,12,0"/>
        </Grid>
        <Button Content="Suggest" Click="SuggestClick" Padding="8,4"/>
        <Button x:Name="LevelingOptionsButton" Click="LevelingOptionsClick" Width="28" Padding="0" AutomationProperties.Name="Dynamic leveling options"><Path Style="{StaticResource ToolbarIcon}" Data="{StaticResource GearIconGeometry}"/></Button>
       </StackPanel>
      </StackPanel>
     </Border>
     <Border Grid.Column="1" Style="{StaticResource ProcessingSectionSurface}" Tag="{Binding IsChecked, ElementName=MatchingCheck}">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
       <CheckBox x:Name="MatchingCheck" Style="{StaticResource SectionCheckToggle}" IsChecked="True" Checked="ProcessingChanged" Unchecked="ProcessingChanged" AutomationProperties.Name="Enable track matching"/>
       <StackPanel Style="{StaticResource ProcessingSectionBody}" Tag="{Binding IsChecked, ElementName=MatchingCheck}">
        <TextBlock Text="02  TRACK MATCHING" Width="92" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
        <Grid VerticalAlignment="Center" Margin="6,0,0,0">
         <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="14"/><RowDefinition Height="22"/></Grid.RowDefinitions>
         <TextBlock x:Name="MatchingStrengthLabel" Text="Strength" FontSize="10" TextAlignment="Center" VerticalAlignment="Center"/>
         <Slider x:Name="MatchingStrengthSlider" Grid.Row="1" Minimum="0" Maximum="1" Value="1" Width="100" Height="22" SmallChange="0.01" LargeChange="0.1" IsMoveToPointEnabled="False" VerticalAlignment="Center" ValueChanged="MatchingStrengthChanged" PreviewMouseLeftButtonDown="MatchingStrengthEditStarted" PreviewKeyDown="MatchingStrengthKeyDown"/>
         <TextBlock x:Name="MatchingStrengthValueText" Grid.Row="1" Grid.Column="1" Text="100%" Width="46" TextAlignment="Right" FontSize="12" VerticalAlignment="Center" Margin="4,0,10,0"/>
        </Grid>
        <TextBox x:Name="TargetBox" Text="-14" Width="62" FontSize="20" TextAlignment="Center" LostKeyboardFocus="TargetCommit" KeyDown="TargetKeyDown"/>
        <TextBlock Text=" LUFS" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <Button Content="Presets ▾" Click="PresetsClick" Padding="8,4"/>
       </StackPanel>
      </StackPanel>
     </Border>
     <Border Grid.Column="2" Style="{StaticResource ProcessingSectionSurface}" Tag="{Binding IsChecked, ElementName=LimiterCheck}">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
       <CheckBox x:Name="LimiterCheck" Style="{StaticResource SectionCheckToggle}" IsChecked="True" Checked="ProcessingChanged" Unchecked="ProcessingChanged" AutomationProperties.Name="Enable peak protection"/>
       <StackPanel Style="{StaticResource ProcessingSectionBody}" Tag="{Binding IsChecked, ElementName=LimiterCheck}">
        <TextBlock Text="03  PEAK PROTECTION" Width="100" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
        <TextBlock Text="Ceiling" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBox x:Name="CeilingBox" Text="-1.0" Width="62" FontSize="20" TextAlignment="Center" LostKeyboardFocus="CeilingCommit" KeyDown="CeilingKeyDown" AutomationProperties.Name="Output ceiling in dBTP"/>
        <TextBlock Text=" dBTP" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <StackPanel Width="62" VerticalAlignment="Center" Margin="6,0,6,0">
         <Grid x:Name="MaximizerReductionBar" Height="4" Width="62" Margin="0,2,0,4" AutomationProperties.Name="Peak protection gain reduction">
          <Border Background="{DynamicResource BorderBrush}" CornerRadius="2"/>
          <Border x:Name="MaximizerReductionFill" Width="0" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}" CornerRadius="2"/>
         </Grid>
         <TextBlock x:Name="MaximizerReductionText" Text="0.0 dB" TextAlignment="Right" FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource MutedBrush}"/>
        </StackPanel>
        <CheckBox x:Name="DeltaCheck" Style="{StaticResource MonitoringToggle}" IsChecked="False" Checked="PeakDeltaChanged" Unchecked="PeakDeltaChanged" Width="28" Padding="0" Margin="3,0" ToolTip="Delta" ToolTipService.IsEnabled="True" AutomationProperties.Name="Delta"><Path Style="{StaticResource ToolbarToggleIcon}" Data="{StaticResource SoloIconGeometry}"/></CheckBox>
        <Button x:Name="MaximizerOptionsButton" Click="MaximizerOptionsClick" Width="28" Padding="0" AutomationProperties.Name="Peak protection options"><Path Style="{StaticResource ToolbarIcon}" Data="{StaticResource GearIconGeometry}"/></Button>
       </StackPanel>
      </StackPanel>
     </Border>
     <StackPanel x:Name="ExportButtons" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
      <Button x:Name="ExportOptionsButton" Style="{StaticResource ExportOptionsSegment}" Tag="First" Width="36" Padding="0" Click="ExportOptionsClick" AutomationProperties.Name="Export settings"><Path Style="{StaticResource ToolbarIcon}" Data="{StaticResource GearIconGeometry}"/></Button>
      <Border Width="1" Background="{DynamicResource BackgroundBrush}"/>
      <Button x:Name="ExportButton" Style="{StaticResource PrimaryCommandSegment}" Tag="Last" Click="ExportClick" AutomationProperties.Name="Export all audio files">
       <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path Style="{StaticResource ToolbarIcon}" Data="{StaticResource ExportIconGeometry}" Margin="0,0,8,0"><Path.LayoutTransform><ScaleTransform ScaleX="0.8333333333" ScaleY="0.8333333333"/></Path.LayoutTransform></Path><TextBlock Text="Export all" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel>
      </Button>
     </StackPanel>
    </Grid>
    </ContentControl>
   </ScrollViewer>
  </Border>
  <Border x:Name="StatusFooter" DockPanel.Dock="Bottom" Height="32" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8,3">
   <Grid Height="24">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="StatusText" Text="" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
    <TextBlock x:Name="PreviewLabel" Visibility="Collapsed"/>
    <ProgressBar x:Name="WorkProgress" Grid.Column="1" Height="6" Margin="8,0" IsIndeterminate="True" Visibility="Collapsed"/>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
     <Button x:Name="CancelButton" Content="Cancel" Click="CancelClick" Visibility="Collapsed" Height="22" Margin="3,0" Padding="10,1"/>
     <Button x:Name="RebuildPreviewButton" Style="{StaticResource StatusActionButton}" Content="Process" Click="RebuildClick" Visibility="Collapsed"/>
    </StackPanel>
    <TextBlock x:Name="VersionText" Grid.Column="3" Text="v1.0.0" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,2,0"/>
   </Grid>
  </Border>
  <Grid x:Name="WorkspaceGrid">
   <Grid.ColumnDefinitions><ColumnDefinition Width="250" MinWidth="200"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <DockPanel x:Name="FilesPanel" Grid.Column="0" Background="{DynamicResource PanelBrush}">
    <Grid DockPanel.Dock="Top" Margin="8,8,8,6">
     <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Button x:Name="FolderProjectButton" Click="OpenProjectClick" Width="28" Margin="0" Padding="0" ToolTip="Open Loudline project..." ToolTipService.IsEnabled="True" AutomationProperties.Name="Open Loudline project"><Path Style="{StaticResource ToolbarIcon}" Data="{StaticResource FolderIconGeometry}"/></Button>
     <Button x:Name="AddAudioButton" Style="{StaticResource EmptyReleaseAddButton}" Grid.Column="1" Click="AddFilesClick" Margin="6,0,0,0" HorizontalAlignment="Stretch"><TextBlock x:Name="AddAudioLabel" Text="＋  Add audio files" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
    </Grid>
    <TextBlock x:Name="ReleaseSummary" DockPanel.Dock="Bottom" Text="No audio loaded" Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" Margin="8,4,8,8"/>
    <ListBox x:Name="FileList" SelectionChanged="FileSelectionChanged" MouseDoubleClick="FileDoubleClick" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Tag" Value="{Binding Track}"/></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate>
      <StackPanel>
       <DockPanel><controls:ProcessingSpinner DockPanel.Dock="Right" IsActive="{Binding Processing}" Width="17" Height="17" Margin="7,0,0,0" VerticalAlignment="Center"/><TextBlock Text="{Binding Heading}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/></DockPanel>
       <TextBlock Text="{Binding Format}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/>
       <TextBlock Text="{Binding Loudness}" Visibility="{Binding LoudnessVisibility}" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,5,0,0"/>
       <TextBlock Text="{Binding Status}" Visibility="{Binding StatusVisibility}" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
       <Button Content="Relink…" Visibility="{Binding MissingVisibility}" Click="RelinkTrackClick" HorizontalAlignment="Left" Margin="0,6,0,0"/>
      </StackPanel>
     </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel>
   <GridSplitter x:Name="FileListSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}"/>
   <DockPanel Grid.Column="2" x:Name="WaveformPane">
    <Border x:Name="WideToolbar" DockPanel.Dock="Top" Visibility="Collapsed" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Background="{DynamicResource PanelBrush}" Padding="8,4">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <ContentControl x:Name="WideViewHost" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" HorizontalContentAlignment="Left" Margin="0,0,12,0"/>
      <ContentControl x:Name="WideProcessingHost" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Center"/>
      <ContentControl x:Name="WideOutputHost" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" HorizontalContentAlignment="Right" Margin="12,0,0,0"/>
     </Grid>
    </Border>
    <Border x:Name="CompactViewBar" DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,8">
     <DockPanel LastChildFill="True">
      <ContentControl x:Name="CompactOutputHost" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="14,0,0,0">
      <StackPanel x:Name="OutputControls" Orientation="Horizontal" VerticalAlignment="Center">
       <ComboBox x:Name="OutputDeviceBox" Width="240" Height="28" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="OutputDeviceChanged" DropDownOpened="OutputDeviceDropDownOpened"/>
      </StackPanel>
      </ContentControl>
      <ScrollViewer x:Name="CompactViewViewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center" Padding="0">
      <ContentControl x:Name="CompactViewHost" VerticalAlignment="Center">
      <StackPanel x:Name="ViewControls" Orientation="Horizontal" VerticalAlignment="Center">
       <Border Height="28" BorderThickness="0" CornerRadius="4" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><RadioButton x:Name="OriginalRadio" AutomationProperties.Name="Original" Style="{StaticResource ViewSegment}" Tag="First" GroupName="Display" Checked="ViewChanged"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path Style="{StaticResource ToolbarToggleIcon}" Data="{StaticResource OriginalIconGeometry}" Margin="0,0,6,0"/><TextBlock Text="Original" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=primitives:ToggleButton}}"/></StackPanel></RadioButton><RadioButton x:Name="PreviewRadio" AutomationProperties.Name="Result" Style="{StaticResource ViewSegment}" GroupName="Display" Checked="ViewChanged" IsChecked="True"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path Style="{StaticResource ToolbarToggleIcon}" Data="{StaticResource ResultIconGeometry}" Margin="0,0,6,0"/><TextBlock Text="Result" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=primitives:ToggleButton}}"/></StackPanel></RadioButton><RadioButton x:Name="CompareRadio" AutomationProperties.Name="Comparison" Style="{StaticResource ViewSegment}" Tag="Last" GroupName="Display" Checked="ViewChanged"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path Style="{StaticResource ToolbarToggleIcon}" Data="{StaticResource ComparisonIconGeometry}" Margin="0,0,6,0"/><TextBlock Text="Comparison" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=primitives:ToggleButton}}"/></StackPanel></RadioButton></StackPanel></Border>
       <CheckBox x:Name="WaveformEnvelopeCheck" AutomationProperties.Name="Envelope" IsChecked="True" Checked="EnvelopeOverlayChanged" Unchecked="EnvelopeOverlayChanged" FontSize="12" Margin="10,0,0,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path Style="{StaticResource ToolbarToggleIcon}" Data="{StaticResource EnvelopeIconGeometry}" Margin="0,0,6,0"/><TextBlock Text="Envelope" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=primitives:ToggleButton}}"/></StackPanel></CheckBox>
       <CheckBox x:Name="ShowGains" AutomationProperties.Name="Gains" IsChecked="True" Checked="ViewChanged" Unchecked="ViewChanged" FontSize="12" Margin="5,0,0,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path Style="{StaticResource ToolbarToggleIcon}" Data="{StaticResource GainsIconGeometry}" Margin="0,0,6,0"/><TextBlock Text="Gains" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=primitives:ToggleButton}}"/></StackPanel></CheckBox>
       <CheckBox x:Name="BackgroundVisibilityCheck" AutomationProperties.Name="Background track" IsChecked="True" Checked="BackgroundVisibilityChanged" Unchecked="BackgroundVisibilityChanged" FontSize="12" Margin="5,0,0,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path Style="{StaticResource ToolbarToggleIcon}" Data="{StaticResource BackgroundIconGeometry}" Margin="0,0,6,0"/><TextBlock Text="Background track" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=primitives:ToggleButton}}"/></StackPanel></CheckBox>
       <CheckBox x:Name="CustomBoundariesCheck" AutomationProperties.Name="Custom boundaries" IsChecked="False" Checked="CustomBoundariesChanged" Unchecked="CustomBoundariesChanged" FontSize="12" Margin="5,0,0,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path Style="{StaticResource ToolbarToggleIcon}" Data="{StaticResource CustomBoundariesIconGeometry}" Margin="0,0,6,0"/><TextBlock Text="Custom boundaries" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=primitives:ToggleButton}}"/></StackPanel></CheckBox>
       <Border Style="{StaticResource ToolbarSeparator}"/>
       <StackPanel x:Name="FitButtons" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="FitAllButton" AutomationProperties.Name="Fit all" Style="{StaticResource CommandSegment}" Tag="First" Click="FitAllClick"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path Style="{StaticResource ToolbarIcon}" Data="{StaticResource FitAllIconGeometry}" Margin="0,0,6,0"/><TextBlock Text="Fit all" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button>
        <Border Width="1" Background="{DynamicResource BackgroundBrush}"/>
        <Button x:Name="FitTrackButton" AutomationProperties.Name="Fit track" Style="{StaticResource CommandSegment}" Tag="Last" Click="FitSelectedClick"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path Style="{StaticResource ToolbarIcon}" Data="{StaticResource FitTrackIconGeometry}" Margin="0,0,6,0"/><TextBlock Text="Fit track" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button>
       </StackPanel>
       <Border Style="{StaticResource ToolbarSeparator}"/>
       <CheckBox x:Name="AuditionMatchCheck" AutomationProperties.Name="Level-match A/B" Style="{StaticResource MonitoringToggle}" IsChecked="False" Checked="AuditionMatchChanged" Unchecked="AuditionMatchChanged" FontSize="12" Margin="0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path Style="{StaticResource ToolbarToggleIcon}" Data="{StaticResource DiffIconGeometry}" Width="12" Height="21" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Level-match A/B" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=primitives:ToggleButton}}"/></StackPanel></CheckBox>
       <Border Style="{StaticResource ToolbarSeparator}"/>
       <Button x:Name="SliceButton" Click="SliceAtPlayheadClick" FontSize="12" Margin="0" AutomationProperties.Name="Slice at playhead position" ToolTip="Slice at playhead position (S)" ToolTipService.IsEnabled="True"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path Style="{StaticResource ToolbarIcon}" Data="{StaticResource SliceIconGeometry}" Margin="0,0,6,0"/><TextBlock Text="Slice" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button>
       <Button x:Name="MergeButton" Click="MergeAtPlayheadClick" FontSize="12" Margin="5,0,0,0" AutomationProperties.Name="Merge at nearest boundary" ToolTip="Merge at nearest boundary (M)" ToolTipService.IsEnabled="True"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path Style="{StaticResource ToolbarIcon}" Data="{StaticResource MergeIconGeometry}" Margin="0,0,6,0"/><TextBlock Text="Merge" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button>
       <Button x:Name="InsertSilenceButton" Click="InsertSilenceClick" FontSize="12" Margin="5,0,0,0" AutomationProperties.Name="Insert silence"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path Style="{StaticResource ToolbarIcon}" Data="M3 12h18 M3 8v8 M21 8v8" Margin="0,0,6,0"/><TextBlock Text="Insert silence" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button>
      </StackPanel>
      </ContentControl>
      </ScrollViewer>
     </DockPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBrush}" Padding="12,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
     <Grid x:Name="TransportLayout" Height="36">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid Grid.Column="0" ClipToBounds="True" Margin="0,0,12,0">
       <TextBlock x:Name="SelectionInfo" Text="" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Center" TextAlignment="Left" TextTrimming="CharacterEllipsis"/>
      </Grid>
      <StackPanel x:Name="TransportControls" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
       <Button x:Name="PlayButton" Content="▶" Click="PlayClick" Width="34" Height="28" Padding="0" FontSize="16" AutomationProperties.Name="Play or pause"/>
       <Button x:Name="StopButton" Content="■" Click="StopClick" Width="34" Height="28" Padding="0" FontSize="14" AutomationProperties.Name="Stop"/>
       <TextBlock x:Name="TimeText" Text="00:00:00.000" FontFamily="Consolas" FontSize="23" VerticalAlignment="Center" Margin="14,0,0,0"/>
       <Border Width="1" Height="18" Background="{DynamicResource BorderBrush}" Margin="16,0,12,0"/>
       <TextBlock Text="LOOP:" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
       <StackPanel x:Name="LoopButtons" Orientation="Horizontal" VerticalAlignment="Center">
        <CheckBox x:Name="LoopACheck" Style="{StaticResource LoopAButtonStyle}" IsChecked="False" Checked="LoopToggleChanged" Unchecked="LoopToggleChanged" AutomationProperties.Name="Loop A"><TextBlock Text="A" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}}"/></CheckBox>
        <Border Width="1" Background="{DynamicResource BackgroundBrush}"/>
        <CheckBox x:Name="LoopBCheck" Style="{StaticResource LoopBButtonStyle}" IsChecked="False" Checked="LoopToggleChanged" Unchecked="LoopToggleChanged" AutomationProperties.Name="Loop B"><TextBlock Text="B" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}}"/></CheckBox>
       </StackPanel>
      </StackPanel>
      <Grid Grid.Column="2" ClipToBounds="True" Margin="12,0,0,0">
       <TextBlock x:Name="CursorPositionText" Text="" FontSize="12" FontFamily="Consolas" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis"/>
      </Grid>
     </Grid>
    </Border>
    <Grid x:Name="AudioLanes">
     <Grid.RowDefinitions><RowDefinition Height="82*" MinHeight="240"/><RowDefinition Height="5"/><RowDefinition Height="18*" MinHeight="70"/></Grid.RowDefinitions>
     <Grid Grid.Row="0">
      <controls:TimelineView x:Name="Timeline"/>
      <CheckBox x:Name="AutoProcessToggle" IsChecked="True" Checked="AutoProcessChanged" Unchecked="AutoProcessChanged" HorizontalAlignment="Center" VerticalAlignment="Center" Height="56" Padding="24,10" Margin="12" FontSize="18" AutomationProperties.Name="Auto-process immediately">
       <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Path Style="{StaticResource ToolbarToggleIcon}" Width="24" Height="24" Margin="0,0,12,0" Data="M15.914 4a1.5 1.5 0 00-2.474-1.561l-9 9A1.5 1.5 0 005.5 14h4.002a.5.5 0 01.471.666L8.086 20a1.5 1.5 0 002.475 1.56l9-9A1.5 1.5 0 0018.5 10h-3.997a.5.5 0 01-.472-.667z"><Path.LayoutTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Path.LayoutTransform></Path>
        <TextBlock Text="Auto-process immediately" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=primitives:ToggleButton}}"/>
       </StackPanel>
      </CheckBox>
     </Grid>
     <GridSplitter x:Name="BackgroundSplitter" Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource BorderBrush}" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"/>
     <DockPanel x:Name="BackgroundPane" Grid.Row="2" Background="{DynamicResource PanelBrush}">
      <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,2">
       <DockPanel Height="28">
        <TextBlock Text="Background (unprocessed)" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <CheckBox x:Name="BackgroundEnabledCheck" AutomationProperties.Name="Enabled" IsChecked="True" Checked="BackgroundEnabledChanged" Unchecked="BackgroundEnabledChanged" VerticalAlignment="Center" Margin="0,0,5,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path Style="{StaticResource ToolbarToggleIcon}" Data="{StaticResource PowerIconGeometry}" Margin="0,0,6,0"/><TextBlock Text="Enabled" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=primitives:ToggleButton}}"/></StackPanel></CheckBox>
        <CheckBox x:Name="BackgroundSoloButton" AutomationProperties.Name="Solo" Style="{StaticResource MonitoringToggle}" IsChecked="False" Checked="BackgroundSoloChanged" Unchecked="BackgroundSoloChanged" VerticalAlignment="Center" Margin="0,0,12,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path Style="{StaticResource ToolbarToggleIcon}" Data="{StaticResource SoloIconGeometry}" Margin="0,0,6,0"/><TextBlock Text="Solo" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=primitives:ToggleButton}}"/></StackPanel></CheckBox>
        <Button x:Name="AddBackgroundButton" Content="＋" Width="28" Padding="0" Click="AddBackgroundClick" AutomationProperties.Name="Add background audio"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
         <TextBlock Text="Gain" VerticalAlignment="Center" Margin="0,0,6,0"/>
         <Grid VerticalAlignment="Center">
          <TextBlock x:Name="BackgroundGainValue" Text="0" Foreground="{DynamicResource AccentBrush}" Cursor="SizeNS" TextAlignment="Right" VerticalAlignment="Center" MouseLeftButtonDown="BackgroundGainValueMouseDown" MouseMove="BackgroundGainValueMouseMove" MouseLeftButtonUp="BackgroundGainValueMouseUp" LostMouseCapture="BackgroundGainLostCapture"/>
          <TextBox x:Name="BackgroundGainBox" Text="0" Width="34" MaxWidth="34" Height="22" Padding="1,0" TextAlignment="Right" VerticalContentAlignment="Center" Visibility="Collapsed" LostKeyboardFocus="BackgroundGainCommit" PreviewKeyDown="BackgroundGainKeyDown" AutomationProperties.Name="Background gain in decibels"/>
         </Grid>
         <TextBlock Text="dB" VerticalAlignment="Center" Margin="4,0,2,0"/>
        </StackPanel>
       </DockPanel>
      </Border>
      <controls:BackgroundLaneView x:Name="BackgroundLane"/>
     </DockPanel>
    </Grid>
   </DockPanel>
  </Grid>
 </DockPanel>
</Window>
