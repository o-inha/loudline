          <Popup x:Name="PART_Popup" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Placement="Right" HorizontalOffset="-2" VerticalOffset="-3" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
            <Border Background="{DynamicResource PanelBrush}" BorderThickness="0" CornerRadius="3" Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
              <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" MaxHeight="640" KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle"/></ScrollViewer>
            </Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="HasItems" Value="False"><Setter TargetName="MenuArrow" Property="Visibility" Value="Collapsed"/></Trigger>
          <Trigger Property="InputGestureText" Value=""><Setter TargetName="MenuGesture" Property="Visibility" Value="Collapsed"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="MenuIconSlot" Property="Visibility" Value="Visible"/><Setter TargetName="MenuCheck" Property="Visibility" Value="Visible"/><Setter TargetName="MenuIcon" Property="Visibility" Value="Collapsed"/></Trigger>
