        <Trigger Property="IsMouseCaptureWithin" Value="True"><Setter TargetName="PART_VerticalScrollBar" Property="Opacity" Value="1"/><Setter TargetName="PART_HorizontalScrollBar" Property="Opacity" Value="1"/></Trigger>
      </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
