          <Trigger Property="IsSubmenuOpen" Value="True"><Setter TargetName="MenuSurface" Property="Background" Value="{DynamicResource SelectionBrush}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="MenuSurface" Property="Opacity" Value="0.45"/></Trigger>
          <Trigger Property="Role" Value="TopLevelHeader">
            <Setter TargetName="MenuIconSlot" Property="Visibility" Value="Collapsed"/><Setter TargetName="MenuGesture" Property="Visibility" Value="Collapsed"/><Setter TargetName="MenuArrow" Property="Visibility" Value="Collapsed"/>
            <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/><Setter TargetName="PART_Popup" Property="HorizontalOffset" Value="0"/><Setter TargetName="PART_Popup" Property="VerticalOffset" Value="0"/>
          </Trigger>
          <Trigger Property="Role" Value="TopLevelItem"><Setter TargetName="MenuIconSlot" Property="Visibility" Value="Collapsed"/><Setter TargetName="MenuGesture" Property="Visibility" Value="Collapsed"/><Setter TargetName="MenuArrow" Property="Visibility" Value="Collapsed"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
