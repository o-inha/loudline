        <ScrollBar x:Name="PART_VerticalScrollBar" Style="{StaticResource {x:Type ScrollBar}}" Orientation="Vertical" HorizontalAlignment="Right" Margin="0,2,0,2" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{TemplateBinding VerticalOffset}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" Opacity="0"/>
        <ScrollBar x:Name="PART_HorizontalScrollBar" Style="{StaticResource {x:Type ScrollBar}}" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="2,0,2,0" Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}" Value="{TemplateBinding HorizontalOffset}" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" Opacity="0"/>
