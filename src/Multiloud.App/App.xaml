            <UniformGrid Rows="3" Columns="2" Margin="3,5" Opacity="0.85">
              <Ellipse Width="3" Height="3" Fill="{DynamicResource MutedBrush}"/><Ellipse Width="3" Height="3" Fill="{DynamicResource MutedBrush}"/>
              <Ellipse Width="3" Height="3" Fill="{DynamicResource MutedBrush}"/><Ellipse Width="3" Height="3" Fill="{DynamicResource MutedBrush}"/>
              <Ellipse Width="3" Height="3" Fill="{DynamicResource MutedBrush}"/><Ellipse Width="3" Height="3" Fill="{DynamicResource MutedBrush}"/>
