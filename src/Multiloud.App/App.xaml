          </Border>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource SelectionBrush}"/><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
          <DataTrigger Binding="{Binding Missing}" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource MissingBackgroundBrush}"/><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource MissingBorderBrush}"/></DataTrigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter TargetName="TrackRemoveButton" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger SourceName="TrackRemoveButton" Property="IsMouseOver" Value="True"><Setter TargetName="TrackRemoveIcon" Property="Stroke" Value="#D46B70"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
